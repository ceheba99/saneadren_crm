# Copia este archivo como .env y llena los valores. El archivo .env NO se sube a git.

# Dirección pública del CRM (la que abren los usuarios); va en los enlaces de los correos.
APP_URL=http://localhost:3210
# Si se usa detrás de cloudflared en la misma máquina:
# TRUST_PROXY=loopback

# Administrador inicial (útil en un servidor nuevo, p. ej. Render). Solo se aplica si esa
# cuenta no existe o sigue con la contraseña inicial 1234.
# ADMIN_USUARIO=admin
# ADMIN_CORREO=marketing@saneadren.com.mx
# ADMIN_PASSWORD=
# Usuarios fijos que se crean al arrancar (útil sin disco persistente). La contraseña nunca va en el código.
# USUARIO_PRUEBA_NOMBRE=Karla
# USUARIO_PRUEBA_PASSWORD=
# USUARIO_2_NOMBRE=Luis Perea   (es el nombre por defecto)
# USUARIO_2_PASSWORD=
# USUARIO_2_ROL=ventas

# Ruta de la base de datos (en Render: la de su disco persistente, p. ej. /var/data/saneadren.db)
# DB_PATH=

# Google Workspace (correo de saneadren.com.mx)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=servicios@saneadren.com.mx
# Contraseña de aplicación de 16 letras (NO la contraseña normal de la cuenta)
SMTP_PASS=
CORREO_REMITENTE=Saneadren CRM <servicios@saneadren.com.mx>

# ---------- Servidor ----------
# Puerto en el que escucha el CRM (Plesk/Render lo ponen solos).
# PORT=3210
# Ruta del archivo de la base de datos (fuera del sitio web). Sin ella se usa saneadren.db junto al proyecto.
# DB_PATH=/var/www/vhosts/ejemplo.com/crm-datos/saneadren.db
# Detrás de un proxy (Plesk, Nginx, Cloudflare): número de saltos de proxy, para ver la IP real en los límites de intentos.
# TRUST_PROXY=1
# Dominio de correo permitido para las cuentas (por omisión saneadren.com.mx).
# DOMINIO_CORREO=saneadren.com.mx

# ---------- Administrador inicial ----------
# Crea o recupera la cuenta del administrador al arrancar. Después de entrar y cambiar la contraseña en el CRM,
# conviene QUITAR ADMIN_PASSWORD del servidor (queda a la vista en el panel).
# ADMIN_USUARIO=Administracion
# ADMIN_CORREO=nombre@saneadren.com.mx
# ADMIN_PASSWORD=

# ---------- Cifrado de datos sensibles (CLABE, RFC, CURP, NSS, salarios, documentos del personal) ----------
# 64 caracteres hexadecimales: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Guárdala aparte en un lugar seguro: sin ella los datos cifrados NO se recuperan. Nunca la subas al repositorio.
# CLAVE_CIFRADO=
# Solo al cambiar de clave: la anterior, para volver a cifrar todo con la nueva al arrancar (luego se quita).
# CLAVE_CIFRADO_ANTERIOR=

# ---------- Respaldos automáticos (copia diaria junto a la base) ----------
# RESPALDOS=0 los apaga; RESPALDOS_DIAS = cuántos días se conservan (14 por omisión).
# RESPALDOS=1
# RESPALDOS_DIAS=14

# ---------- Versión demo (SOLO en el servidor de prueba, p. ej. Render; NUNCA en el sistema real) ----------
# Con base vacía siembra datos de ejemplo y botones «Entrar como…» sin contraseña.
# MODO_DEMO=1
