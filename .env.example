# Copia este archivo como .env y llena los valores. El archivo .env NO se sube a git.

# Dirección pública del CRM (la que abren los usuarios); va en los enlaces de los correos.
APP_URL=http://localhost:3210
# Si se usa detrás de cloudflared en la misma máquina:
# TRUST_PROXY=loopback

# Administrador inicial (útil en un servidor nuevo, p. ej. Render). Solo se aplica si esa
# cuenta no existe o sigue con la contraseña inicial 1234.
# ADMIN_USUARIO=admin
# ADMIN_CORREO=marketing@saneadren.com.mx
# ADMIN_PASSWORD=
# Usuarios fijos que se crean al arrancar (útil sin disco persistente). La contraseña nunca va en el código.
# USUARIO_PRUEBA_NOMBRE=Karla
# USUARIO_PRUEBA_PASSWORD=
# USUARIO_2_NOMBRE=Luis Perea   (es el nombre por defecto)
# USUARIO_2_PASSWORD=
# USUARIO_2_ROL=ventas

# Ruta de la base de datos (en Render: la de su disco persistente, p. ej. /var/data/saneadren.db)
# DB_PATH=

# Google Workspace (correo de saneadren.com.mx)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=servicios@saneadren.com.mx
# Contraseña de aplicación de 16 letras (NO la contraseña normal de la cuenta)
SMTP_PASS=
# Solo para probar en tu computadora sin SMTP: 1 = imprime el correo completo (con su enlace) en la consola. Nunca en el servidor.
# CORREO_CONSOLA=
CORREO_REMITENTE=Saneadren CRM <servicios@saneadren.com.mx>
# Correos extra (separados por coma) que reciben el aviso «el reloj checador no responde». Dirección lo recibe siempre.
# CORREO_AVISOS_CHECADOR=

# ---------- Servidor ----------
# Puerto en el que escucha el CRM (Plesk/Render lo ponen solos).
# PORT=3210
# Ruta del archivo de la base de datos (fuera del sitio web). Sin ella se usa saneadren.db junto al proyecto.
# DB_PATH=/var/www/vhosts/ejemplo.com/crm-datos/saneadren.db
# Detrás de un proxy (Plesk, Nginx, Cloudflare): número de saltos de proxy, para ver la IP real en los límites de intentos.
# TRUST_PROXY=1
# Dominio de correo permitido para las cuentas (por omisión saneadren.com.mx).
# DOMINIO_CORREO=saneadren.com.mx

# ---------- Administrador inicial ----------
# Crea o recupera la cuenta del administrador al arrancar. Después de entrar y cambiar la contraseña en el CRM,
# conviene QUITAR ADMIN_PASSWORD del servidor (queda a la vista en el panel).
# ADMIN_USUARIO=Administracion
# ADMIN_CORREO=nombre@saneadren.com.mx
# ADMIN_PASSWORD=

# ---------- Cifrado de datos sensibles (CLABE, RFC, CURP, NSS, salarios, documentos del personal) ----------
# 64 caracteres hexadecimales: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Guárdala aparte en un lugar seguro: sin ella los datos cifrados NO se recuperan. Nunca la subas al repositorio.
# CLAVE_CIFRADO=
# Solo al cambiar de clave: la anterior, para volver a cifrar todo con la nueva al arrancar (luego se quita).
# CLAVE_CIFRADO_ANTERIOR=

# ---------- Respaldos automáticos (copia diaria junto a la base) ----------
# RESPALDOS=0 los apaga; RESPALDOS_DIAS = cuántos días se conservan (14 por omisión).
# RESPALDOS=1
# RESPALDOS_DIAS=14

# ---------- Facturación CFDI 4.0 con factura.com (en construcción) ----------
# Las llaves se sacan del panel de factura.com: Configuraciones → API → Datos de acceso (sandbox y producción son paneles distintos,
# cada uno con sus llaves). Van SOLO aquí (y en las variables del servidor), nunca en el repositorio ni en el chat. Para revisar
# qué está puesto, sin mostrar las llaves:  npm run facturacion-estado
# FACTURA_ENV: sandbox (pruebas, sin validez fiscal; es lo que se usa si no se pone nada) o prod (timbres con validez fiscal).
# Cada entorno tiene SUS PROPIAS variables y solo se leen las del entorno activo: así no se mezclan las llaves por descuido.
# FACTURA_ENV=sandbox
# Sandbox: el emisor es un RFC de PRUEBA con sellos de prueba; aquí van su régimen y su CP (los que muestra el panel de sandbox).
# FACTURA_SANDBOX_API_KEY=
# FACTURA_SANDBOX_SECRET_KEY=
# FACTURA_SANDBOX_EMISOR_REGIMEN=
# FACTURA_SANDBOX_EMISOR_CP=
# Producción: los datos reales del emisor (régimen fiscal con clave de 3 números, como en la Constancia, y código postal de
# expedición). Cada sucursal puede tener su propio CP de expedición; si no, se usa este.
# FACTURA_PROD_API_KEY=
# FACTURA_PROD_SECRET_KEY=
# FACTURA_PROD_EMISOR_REGIMEN=
# FACTURA_PROD_EMISOR_CP=
# RFC de Saneadren (el de la Constancia de Situación Fiscal). Con él, al subir el XML de la factura de un gasto se revisa que
# venga a nombre de Saneadren; si falta, el XML se acepta pero se avisa que no se revisó. Se pueden poner varios separados por coma.
# FACTURA_PROD_EMISOR_RFC=

# ---------- Marketing: limpieza automática de archivos ----------
# Lo quitado hace más de 60 días (y las imágenes de publicaciones canceladas hace más de 60 días) se borra del disco.
# Corre al arrancar y cada 6 horas; solo las pruebas cambian cada cuánto (en milisegundos). No hace falta configurarla.
# MARKETING_LIMPIEZA_MS=21600000

# ---------- Reloj checador: fotos ----------
# Las fotos de las checadas se borran solas pasados estos días (la checada se conserva). Mínimo 7; si no se pone, 90.
# Debe coincidir con lo que dice el aviso de privacidad del personal (public/aviso-privacidad-checador.html).
# FOTOS_CHECADAS_DIAS=90

# ---------- Versión demo (SOLO en el servidor de prueba, p. ej. Render; NUNCA en el sistema real) ----------
# Con base vacía siembra datos de ejemplo y botones «Entrar como…» sin contraseña.
# MODO_DEMO=1

# --- Checar por WhatsApp (foráneos, server/whatsapp.js) ---
# Se sacan del panel de Meta (WhatsApp Business Platform → tu app). Sin las 4, el bot no acepta mensajes.
# WHATSAPP_TOKEN = token permanente de un «usuario del sistema»; WHATSAPP_PHONE_ID = «Identificador del número de teléfono»;
# WHATSAPP_VERIFY_TOKEN = una frase que tú inventas y pegas igual en Meta al configurar el webhook;
# WHATSAPP_APP_SECRET = «Clave secreta de la app» (Configuración → Básica). Webhook: https://<tu dominio>/api/publico/whatsapp
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# WHATSAPP_API_URL=https://graph.facebook.com/v27.0
# Avisos por WhatsApp (server/avisos.js, 2026-11-11): Meta solo deja mandar mensajes que la persona no pidió con una
# PLANTILLA aprobada. Créala en WhatsApp Manager → Plantillas (categoría «Utilidad», idioma Español (MEX)), con este
# cuerpo: «📢 Aviso de Saneadren: {{1}} — {{2}} Marca Enterado en el reloj checador o en tu celular.»
# Cuando Meta la apruebe, pon aquí su nombre exacto. Sin esto, la casilla de WhatsApp sale apagada.
WHATSAPP_PLANTILLA_AVISO=
# WHATSAPP_PLANTILLA_IDIOMA=es_MX

# --- Biométrico facial del kiosco (server/biometria.js) ---
# Distancia máxima entre la cara al checar y la registrada para decir «es la misma persona» (0.55 por omisión).
# Más bajo = más estricto (más «no coincide»); más alto = más permisivo. Cambiarlo solo si hay muchos errores.
# BIOMETRIA_UMBRAL=0.55
